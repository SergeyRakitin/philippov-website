---
// Видео-эмбед: responsive iframe 16:9 (YouTube/Vimeo) либо ссылка-фоллбэк.
import { t, type Lang } from '../i18n/translations';
import { getLocalized } from '../lib/i18n-helpers';
import { getVideoEmbedUrl } from '../lib/mediaHelpers';
import type { VideoItem } from '../lib/sanity';

interface Props {
  lang: Lang;
  item: VideoItem;
}

const { lang, item } = Astro.props;
const title = getLocalized(item.title, lang);
const embedUrl = getVideoEmbedUrl(item.url);
---

<div class="reveal">
  {embedUrl ? (
    <div class="embed-16x9">
      <iframe
        src={embedUrl}
        title={title || t(lang, 'media.video')}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  ) : (
    <a href={item.url} target="_blank" rel="noopener noreferrer" class="block group">
      <div
        class="embed-16x9 flex items-center justify-center"
        style="background: var(--color-surface);"
      >
        <span class="link-arrow">
          {t(lang, 'media.watch')}
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7-7 7M21 12H3" />
          </svg>
        </span>
      </div>
    </a>
  )}

  {title && <p class="mt-3 text-sm text-text-secondary">{title}</p>}
</div>
