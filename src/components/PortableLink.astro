---
// Кастомная отрисовка аннотации-ссылки 'link' (Portable Text mark).
// astro-portabletext передаёт узел в Astro.props.node; содержимое — через <slot/>.
import type { MarkProps } from 'astro-portabletext/types';

type LinkMark = { href?: string };
type Props = MarkProps<LinkMark>;

const { node } = Astro.props;
const href = node.markDef?.href ?? '#';
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
