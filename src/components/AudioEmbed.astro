---
// Аудио-эмбед: iframe SoundCloud/Spotify либо ссылка.
import { t, type Lang } from '../i18n/translations';
import { detectProvider, getAudioEmbedUrl, getAudioEmbedHeight } from '../lib/mediaHelpers';
import type { AudioItem } from '../lib/sanity';

interface Props {
  lang: Lang;
  item: AudioItem;
}

const { lang, item } = Astro.props;
const provider = detectProvider(item.url);
const isSoundCloud = provider === 'soundcloud';
const embedUrl = getAudioEmbedUrl(item.url);
const height = getAudioEmbedHeight(provider === 'spotify' ? 'spotify' : 'soundcloud');
---

<div class="reveal">
  {embedUrl ? (
    <div class:list={['audio-embed', { 'soundcloud-embed': isSoundCloud }]}>
      <iframe
        src={embedUrl}
        title={isSoundCloud ? 'SoundCloud' : 'Spotify'}
        width="100%"
        height={height}
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      ></iframe>
    </div>
  ) : (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-between gap-4 p-4 border group transition-colors"
      style="border-color: var(--color-line-soft); border-radius: var(--radius-md); background: var(--color-surface);"
    >
      <span class="text-text-secondary group-hover:text-paper transition-colors">{t(lang, 'media.audio')}</span>
      <span class="link-arrow">
        {t(lang, 'media.listen')}
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7-7 7M21 12H3" />
        </svg>
      </span>
    </a>
  )}
</div>

<style>
  .audio-embed {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .audio-embed:not(.soundcloud-embed) { border: 1px solid var(--color-line-soft); }
  iframe {
    display: block;
    width: 100%;
    border: 0;
  }
  .soundcloud-embed iframe {
    filter: invert(1) hue-rotate(180deg) brightness(0.9) contrast(1.05);
  }
</style>
