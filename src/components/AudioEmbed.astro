---
// Аудио-эмбед: iframe SoundCloud/Spotify либо ссылка-фоллбэк.
import { t, type Lang } from '../i18n/translations';
import { getLocalized } from '../lib/i18n-helpers';
import { detectProvider, getAudioEmbedUrl, getAudioEmbedHeight } from '../lib/mediaHelpers';
import type { AudioItem } from '../lib/sanity';

interface Props {
  lang: Lang;
  item: AudioItem;
}

const { lang, item } = Astro.props;
const title = getLocalized(item.title, lang);
const provider = detectProvider(item.url) as 'soundcloud' | 'spotify' | null;
const embedUrl = getAudioEmbedUrl(item.url);
const height = getAudioEmbedHeight(provider === 'spotify' ? 'spotify' : provider === 'soundcloud' ? 'soundcloud' : null);
---

<div class="reveal">
  {embedUrl ? (
    <div
      class="overflow-hidden border"
      style={`border-color: var(--color-line-soft); border-radius: var(--radius-md); background: var(--color-surface);`}
    >
      <iframe
        src={embedUrl}
        title={title || t(lang, 'media.audio')}
        width="100%"
        height={height}
        loading="lazy"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        style="display:block; border:0;"
      ></iframe>
    </div>
  ) : (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-between gap-4 p-4 border group transition-colors"
      style="border-color: var(--color-line-soft); border-radius: var(--radius-md); background: var(--color-surface);"
    >
      <span class="text-text-secondary group-hover:text-paper transition-colors">
        {title || t(lang, 'media.audio')}
      </span>
      <span class="link-arrow">
        {t(lang, 'media.listen')}
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7-7 7M21 12H3" />
        </svg>
      </span>
    </a>
  )}

  {title && embedUrl && <p class="mt-3 text-sm text-text-secondary">{title}</p>}
</div>
