---
// Аудио-эмбед: iframe SoundCloud/Spotify либо ссылка-фоллбэк.
import { t, type Lang } from '../i18n/translations';
import { getLocalized } from '../lib/i18n-helpers';
import { detectProvider, getAudioEmbedUrl, getAudioEmbedHeight } from '../lib/mediaHelpers';
import type { AudioItem } from '../lib/sanity';

interface Props {
  lang: Lang;
  item: AudioItem;
}

const { lang, item } = Astro.props;
const title = getLocalized(item.title, lang);
const provider = detectProvider(item.url) as 'soundcloud' | 'spotify' | null;
const embedUrl = getAudioEmbedUrl(item.url);
const height = getAudioEmbedHeight(provider === 'spotify' ? 'spotify' : provider === 'soundcloud' ? 'soundcloud' : null);
---

<div class="reveal">
  {item.fileUrl ? (
    <div class="audio-player" data-audio-player>
      <audio class="audio-player__media" preload="metadata" src={item.fileUrl}></audio>
      <button
        type="button"
        class="audio-player__btn"
        data-audio-toggle
        aria-label={t(lang, 'media.play')}
        data-label-play={t(lang, 'media.play')}
        data-label-pause={t(lang, 'media.pause')}
      >
        <svg class="audio-player__icon audio-player__icon--play" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 5v14l11-7z" />
        </svg>
        <svg class="audio-player__icon audio-player__icon--pause" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5v14M15 5v14" />
        </svg>
      </button>
      <div class="audio-player__body">
        {title && <p class="audio-player__title">{title}</p>}
        <div class="audio-player__bar" data-audio-bar>
          <div class="audio-player__fill" data-audio-fill></div>
        </div>
        <div class="audio-player__time">
          <span data-audio-current>0:00</span>
          <span data-audio-duration>0:00</span>
        </div>
      </div>
    </div>
  ) : embedUrl ? (
    <div
      class="overflow-hidden border"
      style={`border-color: var(--color-line-soft); border-radius: var(--radius-md); background: var(--color-surface);`}
    >
      <iframe
        src={embedUrl}
        title={title || t(lang, 'media.audio')}
        width="100%"
        height={height}
        loading="lazy"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        style="display:block; border:0;"
      ></iframe>
    </div>
  ) : (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-between gap-4 p-4 border group transition-colors"
      style="border-color: var(--color-line-soft); border-radius: var(--radius-md); background: var(--color-surface);"
    >
      <span class="text-text-secondary group-hover:text-paper transition-colors">
        {title || t(lang, 'media.audio')}
      </span>
      <span class="link-arrow">
        {t(lang, 'media.listen')}
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7-7 7M21 12H3" />
        </svg>
      </span>
    </a>
  )}

  {title && embedUrl && !item.fileUrl && <p class="mt-3 text-sm text-text-secondary">{title}</p>}
</div>

<script>
  // Кастомный плеер для загруженных файлов. Astro дедупит модульные <script> —
  // этот блок исполняется один раз глобально; инициализация per-instance.
  function fmt(sec: number): string {
    if (!isFinite(sec) || sec < 0) sec = 0;
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${s < 10 ? '0' : ''}${s}`;
  }

  function wire(root: HTMLElement): void {
    const audio = root.querySelector<HTMLAudioElement>('.audio-player__media');
    const btn = root.querySelector<HTMLButtonElement>('[data-audio-toggle]');
    const bar = root.querySelector<HTMLElement>('[data-audio-bar]');
    const fill = root.querySelector<HTMLElement>('[data-audio-fill]');
    const curEl = root.querySelector<HTMLElement>('[data-audio-current]');
    const durEl = root.querySelector<HTMLElement>('[data-audio-duration]');
    if (!audio || !btn || !bar || !fill || !curEl || !durEl) return;

    const labelPlay = btn.dataset.labelPlay || 'Play';
    const labelPause = btn.dataset.labelPause || 'Pause';

    btn.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });

    audio.addEventListener('play', () => {
      root.classList.add('is-playing');
      btn.setAttribute('aria-label', labelPause);
    });
    audio.addEventListener('pause', () => {
      root.classList.remove('is-playing');
      btn.setAttribute('aria-label', labelPlay);
    });

    audio.addEventListener('loadedmetadata', () => {
      durEl.textContent = fmt(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      const ratio = audio.duration ? audio.currentTime / audio.duration : 0;
      fill.style.width = `${ratio * 100}%`;
      curEl.textContent = fmt(audio.currentTime);
    });

    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      fill.style.width = '0%';
      root.classList.remove('is-playing');
    });

    bar.addEventListener('click', (e) => {
      if (!audio.duration) return;
      const rect = bar.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      audio.currentTime = ratio * audio.duration;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-audio-player]').forEach(wire);
</script>
