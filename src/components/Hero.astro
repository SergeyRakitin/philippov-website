---
// Hero: полноэкранный центрированный sticky-раннер с параллаксом и плавным
// затемнением. Контент — из siteSettings (Sanity). Работает gracefully без фото:
// фон тогда — сплошной --color-ink (background-image не задан).
import { type Lang } from '../i18n/translations';
import { getLocalized } from '../lib/i18n-helpers';
import { urlFor, type SiteSettings } from '../lib/sanity';

interface Props {
  lang: Lang;
  settings: SiteSettings | null;
}

const { lang, settings } = Astro.props;

const name = getLocalized(settings?.name, lang);
const role = getLocalized(settings?.role, lang);
const tagline = getLocalized(settings?.heroTagline, lang);
const statusNote = getLocalized(settings?.statusNote, lang);

// Фон увеличен (inset:-20%) → берём с запасом по ширине.
const heroImageUrl = settings?.heroImage
  ? urlFor(settings.heroImage).width(2400).quality(82).auto('format').url()
  : '';
---

<div class="hero-wrapper">
  <section id="hero" class="hero-sticky" aria-label="Intro">
    <!-- Параллакс-фон (фото или сплошной --color-ink, если фото нет) -->
    <div
      id="hero-bg"
      class:list={['hero-bg', heroImageUrl && 'hero-bg-photo']}
      style={heroImageUrl ? `background-image: url('${heroImageUrl}')` : undefined}
      aria-hidden="true"
    ></div>

    <!-- Статичный градиент-оверлей -->
    <div class="hero-gradient" aria-hidden="true"></div>

    <!-- Fade-оверлей (затемнение в фон на скролле; opacity пишет JS) -->
    <div id="hero-fade" class="hero-fade" aria-hidden="true"></div>

    <!-- Контент: eyebrow → имя → tagline → статус -->
    <div id="hero-content" class="hero-content">
      {role && <p class="eyebrow mb-6">{role}</p>}

      {name && <h1 class="hero-name">{name}</h1>}

      {tagline && <p class="hero-tagline mt-7">{tagline}</p>}

      {statusNote && (
        <p class="mt-9 inline-flex items-center gap-2.5 eyebrow-muted">
          <span class="status-dot" aria-hidden="true"></span>
          {statusNote}
        </p>
      )}
    </div>

    <!-- Скролл-стрелка (гаснет на скролле) -->
    <div id="hero-scroll-indicator" class="hero-scroll-indicator" aria-hidden="true">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7" />
      </svg>
    </div>
  </section>
</div>

<script>
  import { initParallax } from '../lib/parallaxEffect';

  // В проекте нет ViewTransitions — обычная инициализация (модульный скрипт
  // исполняется после парсинга разметки Hero).
  const bg = document.getElementById('hero-bg');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bg && !prefersReducedMotion) {
    initParallax({
      bgSelector: '#hero-bg',
      fadeSelector: '#hero-fade',
      contentSelector: '#hero-content',
      indicatorSelector: '#hero-scroll-indicator',
      wrapperSelector: '.hero-wrapper',
    });
  }
</script>
