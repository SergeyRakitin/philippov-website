---
// Sticky-навигация: имя/лого, якоря (About, разделы, Contact), переключатель языка,
// мобильное меню (бургер).
import { t, type Lang } from '../i18n/translations';
import { getLocalized, langHome } from '../lib/i18n-helpers';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Section } from '../lib/sanity';

interface Props {
  lang: Lang;
  brand: string;
  sections: Section[];
  hasAbout: boolean;
  hasContact: boolean;
}

const { lang, brand, sections, hasAbout, hasContact } = Astro.props;
const homeHref = langHome(lang); // base-aware домашняя текущего языка

// Пункты-якоря: About → разделы → Contact.
// Чистые хэши — сайт одностраничный, якорь всегда на текущей странице (base-независимо).
type NavItem = { href: string; label: string };
const navItems: NavItem[] = [];

if (hasAbout) navItems.push({ href: '#about', label: t(lang, 'nav.about') });

for (const s of sections) {
  const slug = s.slug?.current;
  const title = getLocalized(s.title, lang);
  if (slug && title) navItems.push({ href: `#${slug}`, label: title });
}

if (hasContact) navItems.push({ href: '#contact', label: t(lang, 'nav.contact') });
---

<header
  class="sticky top-0 z-50 border-b border-line-soft"
  style="background: color-mix(in srgb, var(--color-ink) 82%, transparent); backdrop-filter: blur(12px);"
>
  <div class="container-site">
    <nav
      class="flex items-center justify-between h-20"
      aria-label={t(lang, 'nav.siteNavigation')}
    >
      <!-- Бренд / имя -->
      <a
        href={homeHref}
        class="font-display text-xl md:text-2xl font-light tracking-tight text-paper hover:text-accent transition-colors"
        style="font-family: var(--font-display);"
      >
        {brand}
      </a>

      <!-- Десктоп-навигация -->
      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a href={item.href} class="nav-link">{item.label}</a>
        ))}
        <span class="w-px h-4 bg-line" aria-hidden="true"></span>
        <LanguageSwitcher lang={lang} />
      </div>

      <!-- Бургер (мобильный) -->
      <button
        type="button"
        id="nav-toggle"
        class="md:hidden flex items-center justify-center w-11 h-11 -mr-2 text-paper"
        aria-label={t(lang, 'menu.open')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Мобильное меню -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-line-soft"
    style="background: var(--color-ink);"
  >
    <div class="container-site py-6 flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link py-3 text-base"
          data-mobile-link
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 mt-2 border-t border-line-soft">
        <LanguageSwitcher lang={lang} />
      </div>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const open = () => {
      menu.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });

    menu.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', close);
    });

    // Закрытие по Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  initHeader();
</script>
